# Copy to .env to change these settings. All of them are optional.

# Folder for uploaded files and the SQLite database
DATA_DIR=data

# Largest accepted upload, in bytes (10 MB)
MAX_UPLOAD_BYTES=10485760

# Placeholder only, not used. This proof of concept runs on a Claude Code subscription.
ANTHROPIC_API_KEY=dummy-key

# The Claude Code command used to read invoices
CLAUDE_COMMAND=claude

# The model and effort level used to read invoices
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=medium

# How long one extraction may run before it fails, in seconds
EXTRACTION_TIMEOUT_SECONDS=180
